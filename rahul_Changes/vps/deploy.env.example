# Copy to vps/deploy.env (gitignored) and fill in before deploy.
# NEVER commit deploy.env — it may contain host paths and SSH key paths.

# --- Lightsail / SSH ---
VPS_HOST=0.0.0.0
VPS_USER=ubuntu
VPS_SSH_KEY=~/.ssh/LightsailDefaultKey-ap-south-1.pem
VPS_REGION=ap-south-1
VPS_STATIC_IP=

# Remote install path on the VPS
BATMAN_ROOT=/home/ubuntu/batman-algo
BATMAN_USER=ubuntu

# Stage A stays UAT (live Nifty ticks, shadow orders)
BATMAN_MODE=uat

# Watchdog Telegram (reuse JAGRAN alerts or a dedicated ops chat)
# Leave empty to skip copying notifier .env; set path to a local .env with:
#   TELEGRAM_BOT_TOKEN=...
#   TELEGRAM_CHAT_ID=...
VPS_MONITOR_TELEGRAM_ENV=

# AWS CLI provision (optional — only needed for scripts/aws_lightsail_provision.py)
LIGHTSAIL_INSTANCE_NAME=batman-algo-uat
LIGHTSAIL_BLUEPRINT=ubuntu_24_04
LIGHTSAIL_BUNDLE=medium_3_0
# medium_3_0 ≈ 2 vCPU / 4 GB on Lightsail (confirm in console if AWS renames bundles)
