# Batman Phase-1 — SARANSH (cycle / daily summary)

[Unit]
Description=Batman Phase-1 SARANSH (reporting)
After=network-online.target batman-drishti.service batman-kavach2.service
Wants=network-online.target
PartOf=batman-phase1.target

[Service]
Type=simple
User=__BATMAN_USER__
Group=__BATMAN_USER__
WorkingDirectory=__BATMAN_ROOT__
Environment=BATMAN_LAUNCHED_VIA_BAT=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 10
ExecStart="__PYTHON__" "__BATMAN_ROOT__/run_saransh.py"
Restart=always
RestartSec=10
TimeoutStopSec=45
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=batman-saransh

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=batman-phase1.target
