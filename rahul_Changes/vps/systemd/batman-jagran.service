# Batman Phase-1 — JAGRAN (alerts)

[Unit]
Description=Batman Phase-1 JAGRAN (alerts)
After=network-online.target batman-drishti.service
Wants=network-online.target
PartOf=batman-phase1.target

[Service]
Type=simple
User=__BATMAN_USER__
Group=__BATMAN_USER__
WorkingDirectory=__BATMAN_ROOT__
Environment=BATMAN_LAUNCHED_VIA_BAT=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 5
ExecStart="__PYTHON__" "__BATMAN_ROOT__/run_jagran.py"
Restart=always
RestartSec=10
TimeoutStopSec=45
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=batman-jagran

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=batman-phase1.target
