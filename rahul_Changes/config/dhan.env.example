# Dhan broker secrets — copy to desktop/runtime secrets root (NEVER commit real values)
#
# Canonical locations:
#   <secrets_root>/config/dhan.env     (recommended — Dhan only)
#   <secrets_root>/config/.env         (also supported)
#
# Rahul VPS example:
#   /home/ubuntu/Trading_Runtime_Rahul/Credentials/config/dhan.env
#
# Desktop example:
#   %USERPROFILE%\Desktop\Batman-Secrets\config\dhan.env
#
# Telegram tokens do NOT belong here — use:
#   <secrets_root>/telegram/bots.env

DHAN_CLIENT_CODE=
DHAN_PIN=
DHAN_TOTP_SECRET=
# Optional manual JWT (DRISHTI paste / override). PIN/TOTP can refresh this daily.
# DHAN_ACCESS_TOKEN=
