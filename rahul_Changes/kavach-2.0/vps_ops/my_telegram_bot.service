[Unit]
Description=Telegram Trading Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/my_telegram_bot
EnvironmentFile=/home/ubuntu/my_telegram_bot/.env
ExecStart=/home/ubuntu/my_telegram_bot/venv/bin/python /home/ubuntu/my_telegram_bot/bot.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
