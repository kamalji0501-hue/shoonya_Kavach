# Batman — consolidated Telegram bots (EXAMPLE — safe to commit)
# Copy to your desktop/runtime secrets folder and fill real values:
#
#   <secrets_root>/telegram/bots.env
#   e.g. /home/ubuntu/Trading_Runtime_Rahul/Credentials/telegram/bots.env
#   e.g. %USERPROFILE%\Desktop\Batman-Secrets\telegram\bots.env
#
# The code reads THIS file first. Per-bot token.env remains a fallback.

# --- DRISHTI ---
DRISHTI_BOT_TOKEN=
DRISHTI_CHAT_ID=

# --- KAVACH ---
KAVACH_BOT_TOKEN=
KAVACH_CHAT_ID=

# --- JAGRAN ---
JAGRAN_BOT_TOKEN=
JAGRAN_CHAT_ID=

# --- SARANSH ---
SARANSH_BOT_TOKEN=
SARANSH_CHAT_ID=
